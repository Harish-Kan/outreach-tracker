# Supabase — Dashboard → Project Settings → API
# Copy this file to .env.local and fill in the values.
#
# Both of these are meant to be public: the anon key is shipped to the browser
# and RLS is what actually protects the data. The service role key is not listed
# here on purpose — nothing in this app reads it, and a key that is never
# configured cannot leak.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
